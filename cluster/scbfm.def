Bootstrap: docker
From: pytorch/pytorch:2.1.2-cuda11.8-cudnn8-runtime

%labels
    Author Enrico Heiss
    Application scbFM

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1

%post
    python -m pip install --upgrade pip
    python -m pip install --no-cache-dir \
        hydra-core \
        omegaconf \
        numpy \
        scipy \
        scikit-learn \
        scanpy \
        anndata \
        h5py \
        pandas \
        einops \
        requests

%runscript
    exec "$@"
